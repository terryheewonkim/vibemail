{
  "name": "vibemail-backend",
  "version": "1.0.0",
  "description": "A TypeScript backend that links a user's Gmail account through Google OAuth and exposes a small JSON API for listing, sending, and marking messages read or unread. Messages are always fetched live from Gmail and persisted to PostgreSQL on Supabase before each response.",
